{
    "main": "index.html",
    "logo": "logo.png",
    "preload": "preload.js",
    "pluginSetting": {
        "height": 600
    },
    "features": [
        {
            "code": "test-text",
            "explain": "Java转JSON",
            "cmds": [
                "Java转JSON",
                "json",
                "tostring"
            ]
        },
        {
            "code": "javaToJson",
            "explain": "将 Java 对象的 toString 字符串转换为 JSON 格式",
            "cmds": [
                {
                    "type": "over",
                    "label": "Java转JSON",
                    "minLength": 6,
                    "maxLength": 5000000
                },
                {
                    "type": "regex",
                    "label": "Java转JSON",
                    "match": "/^\\s*\\[.+\\]\\s*$/",
                    "minLength": 6,
                    "maxLength": 5000000
                },
                {
                    "type": "regex",
                    "label": "Java转JSON",
                    "match": "/^BizResponse[({]/",
                    "minLength": 12,
                    "maxLength": 5000000
                }
            ]
        }
    ]
}
